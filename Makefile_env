##env Directory where the bifrost project is, no trailing slash
BIFROST_DIR ?= .
##env Directory for protobuf files, no trailing slash
PROTO_DIR ?= .
##env Arguments for the protoc command
PROTOC_OPT ?=
##env Whether to generate *.pb.go files from protobuf files
GEN_PROTO_GO ?= true
##env Output directory for generated *.pb.go files
GEN_PROTO_GO_OUT ?= .
##env Options for generating *.pb.go files
GEN_PROTO_GO_OPT ?=
##env Whether to generate *_grpc.pb.go files from protobuf files
GEN_PROTO_GO_GRPC ?= true
##env Options for generating *_grpc.pb.go files
GEN_PROTO_GO_GRPC_OPT ?=
##env Whether to generate *_rest.pb.go files from protobuf files
GEN_PROTO_GO_REST ?= true
##env Options for generating *_rest.pb.go files
GEN_PROTO_GO_REST_OPT ?=
##env Whether to generate *_rest_gw.pb.go files from protobuf files
GEN_PROTO_GO_REST_GW ?= true
##env Options for generating *_rest_gw.pb.go files
GEN_PROTO_GO_REST_GW_OPT ?=
##env Whether to generate *.d.tsx files from protobuf files
GEN_PROTO_TS ?= false
##env Options for generating *.d.tsx files
GEN_PROTO_TS_OPT ?=
##env Whether to generate *.enum.tsx files from protobuf files
GEN_PROTO_TS_ENUM ?= false
##env Options for generating *.enum.tsx files
GEN_PROTO_TS_ENUM_OPT ?=
##env Whether to generate *.umi.tsx files from protobuf files
GEN_PROTO_TS_UMI ?= false
##env Options for generating *.umi.tsx files
GEN_PROTO_TS_UMI_OPT ?=
##env Output directory for generated *.pb.ts files
GEN_PROTO_TS_OUT ?= ./..
##env Whether to generate *_asynq.pb.go files from protobuf files
GEN_PROTO_GO_ASYNQ ?= false
##env Options for generating *_asynq.pb.go files
GEN_PROTO_GO_ASYNQ_OPT ?=
##env Whether to generate *_amqp.pb.go files from protobuf files
GEN_PROTO_GO_AMQP ?= false
##env Options for generating *_amqp.pb.go files
GEN_PROTO_GO_AMQP_OPT ?=
##env Whether to generate *_validate.pb.go files from protobuf files
GEN_PROTO_GO_VALIDATE ?= true
##env Options for generating *_validate.pb.go files
GEN_PROTO_GO_VALIDATE_OPT ?=

##env OS environment, options: linux, darwin, windows
GOOS ?= linux
##env Whether to enable CGO, options: 0, 1
CGO_ENABLED ?= 0
##env Build directory
BUILD_DIR ?= .
##env Whether to enable DEBUG mode
DEBUG ?= false

##env Project name
PROJECT_NAME ?= bifrost
##env Deployment environment, options: dev, sit, uat, pro
DEPLOY_ENV ?= dev
##env Service name
SERVICE_NAME ?= bifrost
##env Version number, defaults is content in 'version' file
VERSION ?= $(shell cat version)
