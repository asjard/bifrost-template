##env bifrost项目所在目录,结尾不要有/
BIFROST_DIR ?= .
##env proto协议文件目录,结尾不要有/
PROTO_DIR ?= .
##env 是否根据protobuf文件生成*.pb.go文件
GEN_PROTO_GO ?= true
##env 生成的*.pb.go文件输出目录
GEN_PROTO_GO_OUT ?= ./..
##env 生成*.pb.go需要的参数
GEN_PROTO_GO_OPT ?=
##env 是否根据protobuf文件生成*_grpc.pb.go文件
GEN_PROTO_GO_GRPC ?= true
##env 生成*_grpc.pb.go所需要的参数
GEN_PROTO_GO_GRPC_OPT ?=
##env 是否根据protobuf文件生成*_rest.pb.go文件
GEN_PROTO_GO_REST ?= true
##env 生成*_rest.pb.go所需要的参数
GEN_PROTO_GO_REST_OPT ?=
##env 是否根据protobuf文件生成*_rest_gw.pb.go文件
GEN_PROTO_GO_REST_GW ?= true
##env 生成*_rest_gw.pb.go所需要的参数
GEN_PROTO_GO_REST_GW_OPT ?=
##env 是否根据protobuf文件生成*.d.tsx文件
GEN_PROTO_TS ?= false
##env 生成*.d.tsx所需要的参数
GEN_PROTO_TS_OPT ?=
##env 是否根据protobuf文件生成*.enum.tsx文件
GEN_PROTO_TS_ENUM ?= false
##env 生成*.enum.tsx所需要的参数
GEN_PROTO_TS_ENUM_OPT ?=
##env 是否根据protobuf生成*.umi.tsx文件
GEN_PROTO_TS_UMI ?= fasle
##env 生成*.umi.tsx所需要的参数
GEN_PROTO_TS_UMI_OPT ?=
##env 生成的*.pb.ts文件输出目录
GEN_PROTO_TS_OUT ?= ./..
##env 是否根据protobuf文件生成*_asynq.pb.go文件
GEN_PROTO_GO_ASYNQ ?= false
##env 生成*_asynq.pb.go所需要的参数
GEN_PROTO_GO_ASYNQ_OPT ?=
##env 是否根据protobuf文件生成*_rabbitmq.pb.go文件
GEN_PROTO_GO_RABBITMQ ?= false
##env 生成*_rabbitmq.pb.go所需要的参数
GEN_PROTO_GO_RABBITMQ_OPT ?=
##env 是否根据protobuf文件生成*_validate.pb.go文件
GEN_PROTO_GO_VALIDATE ?= true
##env 生成*_validate.pb.go文件的参数
GEN_PROTO_GO_VALIDATE_OPT ?=

##env 运行环境,可选:linux,darwin,windows
GOOS ?= linux
##env 是否开启CGO,可选:0,1
CGO_ENABLED ?= 0
##env 编译目录
BUILD_DIR ?= .
##env 是否开启DEBUG
DEBUG ?= false

##env 项目名称
PROJECT_NAME ?= bifrost
##env 部署环境,可选:dev,sit,uat,pro
DEPLOY_ENV ?= dev
##env 服务名称
SERVICE_NAME ?= bifrost
